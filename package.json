{
  "name": "@snomiao/langs",
  "version": "1.0.0",
  "description": "Linguistic research tools and language corpus data collector. Includes Japanese word corpus extraction from TWC (Tsukuba Web Corpus) and language model research utilities.",
  "keywords": [
    "linguistics",
    "corpus",
    "language-model",
    "nlp",
    "japanese",
    "twc",
    "tsukuba-web-corpus",
    "word-frequency",
    "language-research"
  ],
  "homepage": "https://github.com/snomiao/langs#readme",
  "bugs": {
    "url": "https://github.com/snomiao/langs/issues"
  },
  "license": "ISC",
  "author": "snomiao@gmail.com",
  "files": [
    "dist",
    "ja",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snomiao/langs.git"
  },
  "scripts": {
    "build": "bun build index.ts --outdir=dist && bun build:umd",
    "build:umd": "bunx rollup dist/index.js --file dist/index.umd.js --format umd --name \"twc\"",
    "prerelease": "bun run build && bun run test",
    "release": "bunx standard-version && git push --follow-tags && npm publish",
    "test": "echo \"Error: no test specified\" && exit 1",
    "fix": "oxlint --fix && oxfmt"
  },
  "dependencies": {
    "playwright": "^1.56.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "@types/jest": "^30.0.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "private": false,
  "type": "module",
  "exports": {
    "import": "./dist/index.js",
    "types": "./index.ts"
  },
  "module": "index.ts",
  "types": "./index.ts"
}
